rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function ok() { return request.auth != null; }
    function role() { return get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role; }
    function staff() { return ok() && role() in ['owner', 'rep']; }

    match /users/{u} {
      allow read: if ok();
      // Owner email
      allow create: if request.auth.uid == u && (request.resource.data.role == 'member'
        || (request.auth.token.email == 'tharunv1557j@gmail.com' && request.resource.data.role == 'owner'));
      allow update: if (request.auth.uid == u && request.resource.data.role == resource.data.role)
        || (ok() && role() == 'owner');
    }
    match /cfg/{x}   { allow read: if ok(); allow write: if staff(); }
    match /posts/{x} { allow read: if ok(); allow write: if staff(); }
    match /chat/{x} {
      allow read: if ok();
      allow create: if ok() && request.resource.data.uid == request.auth.uid
        && request.resource.data.r == role() && request.resource.data.text.size() <= 500;
      allow delete: if staff();
    }
    match /mats/{x} {
      allow read: if ok();
      allow create: if ok() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.ok == false || staff());
      allow update, delete: if staff();
    }
  }
}
